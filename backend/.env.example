MONGO_URL=mongodb://localhost:27017
DB_NAME=localiq
CORS_ORIGINS=http://localhost:3000

# openssl rand -hex 32
JWT_SECRET=change-me
ADMIN_EMAIL=admin@localiq.in
ADMIN_PASSWORD=admin123

# --- LLM provider -------------------------------------------------------------------------
# groq: Groq API, with hosted web search for the research layers.
# openai: any OpenAI-compatible API (OpenAI, Gemini, OpenRouter, Ollama, LM Studio).
LLM_PROVIDER=groq
# auto: Groq web search when GROQ_API_KEY is set, else the built-in retrieval pipeline.
# local: always the built-in retrieval pipeline. groq: Groq only.
RESEARCH_PROVIDER=auto

GROQ_API_KEY=
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_SMART=openai/gpt-oss-120b
GROQ_SEARCH_MODEL=openai/gpt-oss-20b

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-5.4-mini
OPENAI_MODEL_SMART=gpt-5.4

# --- Data sources -------------------------------------------------------------------------
# Free key: https://home.openweathermap.org/api_keys (air quality layer only)
OPENWEATHER_API_KEY=
# Comma-separated mirrors, tried in order
OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# --- Payments (Razorpay test mode) --------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Product limits -----------------------------------------------------------------------
FREE_REPORT_LIMIT=5
# Web-research layers collected per run (4 = all of safety, civic, infra, chatter)
SEARCH_BUDGET_PER_DOSSIER=4
