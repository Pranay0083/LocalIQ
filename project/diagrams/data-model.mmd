erDiagram
    USERS ||--o{ JOBS : starts
    USERS ||--o{ REPORTS : owns
    JOBS |o--o| REPORTS : "report_id"
    REPORTS |o--o{ REPORTS : "lens_of"
    REPORTS ||--o{ CHAT_MESSAGES : "report_id"
    USERS ||--o{ POSTS : "writes when signed in"
    CONTRIB_LINKS ||--o{ POSTS : "link_token, anonymous"
    USERS ||--o{ CONTRIB_LINKS : mints
    POSTS |o--o| PROOFS : "proof_url"
    POSTS ||--o{ VOTES : receives
    USERS ||--o{ VOTES : casts
    USERS ||--o{ ORDERS : pays
    USERS ||--o{ RECOMMENDATIONS : requests
    DOSSIERS ||--o{ REPORTS : "read by run_report"
    DOSSIERS }o--|| CITY_STATS : "percentiles from"

    USERS {
        objectid _id PK
        string email UK
        string password_hash
        string name
        string role "user or admin"
        string plan "free, pro_monthly, pro_annual"
        int reports_used
        int credits
        int recommend_runs
        string persona_key
        object profile
    }
    JOBS {
        string job_id UK
        string user_id FK
        string locality_slug
        string persona_key
        string status "running, done, failed"
        array trace
        object cost
        string report_id
    }
    REPORTS {
        objectid _id PK
        string user_id FK
        string locality_slug
        string persona_key
        string job_id "null for a lens report"
        string lens_of "source report id"
        object composite "score, confidence, coverage"
        object baseline_composite
        object module_scores
        array cards "render blocks + citations"
        object narrative
        array sources
        object layers "ok + collected_at per layer"
        object verifier_stats
        array disputes
        array dropped
        object cost
        string share_token
    }
    DOSSIERS {
        string locality_slug UK
        object domains "air, geo, safety, civic, infra, chatter"
        string updated_at
    }
    CITY_STATS {
        string key UK "bengaluru"
        int localities
        object stats "median, p25, p75, n per module"
        string computed_at
    }
    POSTS {
        objectid _id PK
        string locality_slug
        string kind "fact_claim or experience"
        string claim_type
        string claim_value
        string status "pending, corroborated, verified, unverified"
        bool anonymous
        string user_id "null when anonymous"
        string link_token
        string proof_url
        int upvotes
        int downvotes
        string day
    }
    CONTRIB_LINKS {
        string token UK
        string locality_slug
        string created_by FK
        array gaps
    }
    PROOFS {
        string proof_id UK
        string data "base64 image"
        string mime
        bool anonymous
    }
    VOTES {
        string post_id FK
        string user_id FK
        int value "+1 or -1"
    }
    CHAT_MESSAGES {
        string report_id FK
        string user_id FK
        string role "user or assistant"
        string content
        array used_sources
        string day
    }
    ORDERS {
        string razorpay_order_id
        string user_id FK
        string plan
        int amount "paise"
        string status "created, paid, signature_failed"
    }
    RECOMMENDATIONS {
        string user_id FK
        object persona
        array candidates
        object narrative
        int evaluated
    }
    LOGIN_ATTEMPTS {
        string identifier "ip:email"
        int count
        string last_at
    }
